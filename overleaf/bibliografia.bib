@article{oliveira2024validation,
  title={Validation of the analytical framework To validate our mobility-based spread routes against SARS-CoV-2 pathways in Brazil from Feb 25 to April 30, 2020, we analysed genomic data from Candido and colleagues18 focusing on clades 1 and 2. These clades, with 186 sequences in clade 1 and 167 sequences in clade 2, represent the earliest introductions of the virus and had the largest sample sizes. We reanalysed their phylo geographical inference, reconstructing dissemin-ation routes at the municipality level using provided codes and input data (appendix p 11).},
  author={Oliveira, J.F. and Alencar, A.L. and Cunha, M.C.L.S. and Vasconcelos, A.O. and Cunha, G.G. and Miranda, R.B. and Filho, F.M.H.S. and Silva, C. and Gustani-Buss, E. and Khouri, R. and Cerqueira-Silva, T. and Landau, L. and Barral-Netto, M. and Ramos, P.I.P.},
