@article{oliveira2024propagation,
  title={Using phylogeographical inference, we found that 43 cities were affected by the spread of SARS-CoV-2 clade 1 strains, and 47 cities were affected by clade 2 strains, originating from the city of São Paulo between Feb 25 and April 30, 2020. Likewise, for strains originating in the city of Rio de Janeiro, we found 41 affected cities for clade 1 and 48 for clade 2 (figure 5). 22 (51\%) of the 43 cities affected by clade 1 and 28 (60\%) of the 47 cities affected by clade 2 agree with the outputs of the model considering São Paulo as the source. Similarly, for Rio de Janeiro, these results were 20 (49\%) of 41 (clade 1) and 28 (58\%) of 48 (clade 2). These alignment rates decreased as additional steps were considered (appendix p 22). In clade 1, cities coinciding with the first step cover 421 (28·6\%) of São Paulo’s 1472 mobility patterns and 346 (23·6\%) of Rio de Janeiro’s 1467 mobility patterns (figure 5). In clade 2, this coverage increases to 627 (42·6\%) for São Paulo and 600 (40·9\%) for Rio de Janeiro. These cities are ranked highest for early detection in both São Paulo state and Rio de Janeiro state, indicating reliable options for pathogen detection, which is particularly important in areas where local resources for disease monitoring and response are limited because these cities can serve as key points for early identification and intervention.},
  author={Oliveira, J.F. and Alencar, A.L. and Cunha, M.C.L.S. and Vasconcelos, A.O. and Cunha, G.G. and Miranda, R.B. and Filho, F.M.H.S. and Silva, C. and Gustani-Buss, E. and Khouri, R. and Cerqueira-Silva, T. and Landau, L. and Barral-Netto, M. and Ramos, P.I.P.},
  journal={Lancet Digit Health},
  volume={6},
  pages={e570--e579},
  year={2024},
  publisher={Elsevier}
}

@article{oliveira2024ranking,
  title={We developed a ranking strategy leading to a data-informed selection of cities that could leverage mobility coverage and be part of a sentinel network for clinical sample collection, enhancing the design of Brazil’s currently used influenza-like illness surveillance system while keeping the same number of cities (currently 199). Whereas local constraints, such as resource availability and infra structure, might pose challenges to sentinel placement, our work proposes a framework that facilitates data-informed prioritisation based on the desired mobility coverage achievable by each potential sentinel site. Policy makers can then strategically determine the actual configuration, accounting for these particularities.},
  author={Oliveira, J.F. and Alencar, A.L. and Cunha, M.C.L.S. and Vasconcelos, A.O. and Cunha, G.G. and Miranda, R.B. and Filho, F.M.H.S. and Silva, C. and Gustani-Buss, E. and Khouri, R. and Cerqueira-Silva, T. and Landau, L. and Barral-Netto, M. and Ramos, P.I.P.},
  journal={Lancet Digit Health},
  volume={6},
  pages={e570--e579},
  year={2024},
  publisher={Elsevier}
}

@article{oliveira2024improvements,
  title={Despite these limitations, our study offers valuable insights for future improve ments in mobility data collection methods. Beyond the current scope lies the potential inclusion of variables influencing the selection of cities as sites for early pathogen detection. Factors such as local health priorities and resources, and characteristics favouring the emergence of specific pathogens, could be con-comitantly optimised with our ranking list and other methods28 to better capture the nuances influencing patho gen emergence and the decision to choose a site by the health-care manager. In addition, we have presented evidence that seasonal mobility behaviour could affect the network structure, such that incorporation of these additional layers of information could improve the overall surveillance strategy. Overall, integration of mobility into the design of sentinel networks represents an innovative practice that can improve current surveillance systems.},
  author={Oliveira, J.F. and Alencar, A.L. and Cunha, M.C.L.S. and Vasconcelos, A.O. and Cunha, G.G. and Miranda, R.B. and Filho, F.M.H.S. and Silva, C. and Gustani-Buss, E. and Khouri, R. and Cerqueira-Silva, T. and Landau, L. and Barral-Netto, M. and Ramos, P.I.P.},
