}

@article{oliveira2024manaos,
  title={and at the state and national levels, is provided in the appendix (p 19). We illustrate the outcome obtained by the Ford– Fulkerson method for the emergence of a pathogen initially seeded in four key cities. Among all 1426 paths starting in the city of Manaus, 765 (53·6\%) have the state of São Paulo (ie, the city of São Paulo and neighbouring municipality Campinas) as their initial destination; in other terms, São Paulo state covers 53·6\% of the mobility pattern of Manaus (figure 2A). Brasília in the Federal District (313 [21·9\%] paths), and cities in the states of Pará (145 [10·2\%]), Rondônia (111 [7·8\%]), Roraima (69 [4·8\%]), Ceará (11 [0·8\%]), and Pernambuco (seven [0·5\%]) are the other most likely regions to be affected by an outbreak emerging in Manaus.},
