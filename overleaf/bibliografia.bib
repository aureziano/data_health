@article{oliveira2024emerging,
  title={Predicting the exact location and time of emergence of a new pathogen is a challenging task. Pathogens can appear unnoticed and remain undetected for an extended period before triggering a major outbreak (eg, the Zika virus in the Americas or the different SARS-CoV-2 variants). Our results consider every Brazilian city as a potential source of an outbreak, enabling the design of a mobility-informed sentinel network, increasing the chances of early detection, and providing guidance on how to respond once a new pathogen emerges.},
  author={Oliveira, J.F. and Alencar, A.L. and Cunha, M.C.L.S. and Vasconcelos, A.O. and Cunha, G.G. and Miranda, R.B. and Filho, F.M.H.S. and Silva, C. and Gustani-Buss, E. and Khouri, R. and Cerqueira-Silva, T. and Landau, L. and Barral-Netto, M. and Ramos, P.I.P.},
