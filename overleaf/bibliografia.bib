@article{oliveira2024construction,
  title={Construction of the mobility network and estimation of transport flows The intercity mobility data were used to build a mobility network defined by the graph G=(V, E). Here, V=\{v1,v2,…,vn\} represents a set of n nodes, in which each node (vi ∈ V) corresponds to a city. Additionally, E=\{e1,e2,…em\} represents a set of m links, in which each link (ej ∈ E) possesses the frequency of movement between a pair of cities as an associated weight.},
  author={Oliveira, J.F. and Alencar, A.L. and Cunha, M.C.L.S. and Vasconcelos, A.O. and Cunha, G.G. and Miranda, R.B. and Filho, F.M.H.S. and Silva, C. and Gustani-Buss, E. and Khouri, R. and Cerqueira-Silva, T. and Landau, L. and Barral-Netto, M. and Ramos, P.I.P.},
